MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_DATABASE=zeroone_website
MYSQL_USER=zeroone_app
MYSQL_PASSWORD=replace-with-a-long-db-password

JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=1d
PASSWORD_SALT_ROUNDS=12

ADMIN_NAME=ZeroOne Admin
ADMIN_EMAIL=admin@zerooneitinc.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_ON_START=true
SEED_CHAT_ON_START=true
REQUIRE_DB_ON_START=true
SYNC_DB_ON_START=true
SEQUELIZE_CLEAN_DUP_UNIQUE_INDEXES=true
TEAM_PHOTO_UPLOAD_MAX_MB=25
GEOIP_DB_PATH=/app/geoip/GeoLite2-Country.mmdb

REACT_APP_API_URL=/api
REACT_APP_SITE_URL=https://zerooneitinc.com
REACT_APP_CHAT_STORAGE_TTL_HOURS=24
ZEROONE_WEB_BIND=127.0.0.1
ZEROONE_WEB_PORT=3100

# Optional fallback only. Prefer saving Microsoft Graph values in /admin/mail-config.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=info@zerooneitinc.com
MS_RECIPIENT_EMAIL=info@zerooneitinc.com
